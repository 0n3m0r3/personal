# Inference stays on this machine. Production defaults to OFF.
# Explicitly opt in for a local production-build preview:
PORTFOLIO_CHAT_MODE=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Future public hosting only, after reverse-proxy abuse protection is configured:
# PORTFOLIO_CHAT_MODE=public
# CHAT_PUBLIC_ORIGIN=https://your-portfolio.example
# CHAT_HISTORY_SECRET=replace-with-at-least-32-random-secret-characters
# Never prefix server settings with NEXT_PUBLIC.

# Optional future remote adapter (disabled; no account/model/budget selected).
# Keep CHAT_PROVIDER=ollama for local tests.
CHAT_PROVIDER=ollama
# CHAT_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=vendor/model
# CHAT_MAX_MONTHLY_USD=
# Requires a dedicated OpenRouter key with a monthly credit limit <= that value,
# remaining credits, and "include BYOK usage in limit" enabled.
# Fixed provider price ceilings: $1/M input tokens, $2/M output, $0 per request.
